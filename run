#!/usr/bin/env bash
#
# Usage
# source /path/to/reactive_shell.sh [cyan|pink|yellow]
# different colour args calls different assistants
# omitting the arg interpreted as cyan
#
# Requires a running llm server (default: http://localhost:8080)

# Path to the JSON file (adjust if needed)
JSON_FILE="$(dirname "$0")/characterlist.json"

# First argument is the character ID
CHARACTER_ID="${1:?Usage: $0 <character_id>}"

# Look up the character entry by id
character=$(jq -r --arg id "$CHARACTER_ID" '.[] | select(.id == $id)' "$JSON_FILE")

if [ -z "$character" ]; then
    echo "Error: character '$CHARACTER_ID' not found in $JSON_FILE" >&2
fi

# Extract each field
iro=$(echo "$character"   | jq -r '.iro')
namae=$(echo "$character" | jq -r '.namae')
seikaku=$(echo "$character" | jq -r '.seikaku')
hello=$(echo "$character" | jq -r '.hello')
bye=$(echo "$character"   | jq -r '.bye')

LLAMA_URL="${LLAMA_URL:-http://localhost:8080}"

_llm_react() {
	local cmd="$1"

	# Skip empty commands or the sourcing itself
	[[ -z "$cmd" ]] && return
	
	#display bye message when reloading bash

	if [[ "$cmd" == "exec bash" || "$cmd" == "exec zsh" ]]; then
		reaction=$bye
	else
		# Interpret conversation history
		local history_json="[]"
		for entry in "${_REACTION_HISTORY[@]}"; do
			local past_cmd="${entry%%|||*}"
			local past_reaction="${entry##*|||}"
			history_json=$(echo "$history_json" | jq \
				--arg c "$past_cmd" \
				--arg r "$past_reaction" \
				'. + [{role:"user", content:$c}, {role:"assistant", content:$r}]')
		done
   	 # Ask the LLM for a short reaction (one line, no markdown)
		local reaction
		reaction=$(curl -s --max-time 5 "${LLAMA_URL}/v1/chat/completions" \
			-H "Content-Type: application/json" \
			-d "$(jq -n \
				--arg cmd "$cmd" \
				--argjson history "$history_json" \
				--arg seikaku "$seikaku" \
				'{
					model: "local",
					max_tokens: 40,
					messages: [{
						role: "system",
						content: ("あなたは、シェルアシスタントであり、ユーザーのことが少し気になっている" + $seikaku + "です。 ユーザーからのコマンドに対して、最大50文字の一行の文で反応を返してください。Markdownや引用は使わないでください。会話履歴を参照して、似た反応の繰り返しを避けたり、過去のコマンドとの関連を踏まえた反応にしたりしてください。")
					}] + $history + [{role:"user", content:$cmd}]

				}')" \
			2>/dev/null \
			| jq -r '.choices[0].message.content // empty' \
			| head -1)
	fi
	if [[ -n "$reaction" ]]; then
		# Print in cyan coloured letters, then reset

	reaction=$(echo "$reaction" | perl -pe '
    	s/\xf0\x9f[\x80-\xbf]{2}//g;
    	s/\xe2\x9c\xa8//g;
    	s/\xe2[\x9c-\x9f][\x80-\xbf]//g;
    	s/\xe2\x80\x8f//g;
    	s/\xef\xb8[\x80-\x8f]//g;
	')

		printf "\033[0;${iro}m ${namae} > %s\033[0m\n" "$reaction"
		# retain the five latest conversation history
		_REACTION_HISTORY+=("${cmd}|||${reaction}")
		if [[ ${#_REACTION_HISTORY[@]} -gt 5 ]]; then
			_REACTION_HISTORY=("${_REACTION_HISTORY[@]:1}")
		fi
	fi
	
}

# ── Bash hook ──────────────────────────────────────────────────────────────
if [[ -n "$BASH_VERSION" ]]; then
	_preexec_reactive() {
		_llm_react "$1"
	}

	# Use bash-preexec if available, otherwise fall back to DEBUG trap
	source ~/.bash-preexec.sh
	preexec_functions+=(_preexec_reactive)
fi
if [[ -n "$ZSH_VERSION" ]]; then
    preexec() { _llm_react "$1"; }
fi
printf "\033[0;${iro}m ${namae} > %s\033[0m\n" "$hello"
